<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WebView 加载本地 HTTP 服务、Node 打开网络/本地端口 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务保活（防止 Doze 杀掉 Node 进程） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 常驻运行时的前台服务类型：specialUse。dataSync 在 Android 14+ 有每日限时
         且开机广播路径受 one-time-work 约束，不适合无限期驻留的产品定位。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 息屏后维持内核心跳/网络探测（Doze 会挂起普通 wakelock，前台服务+partial 是
         无 root 常驻的标准组合） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 引导用户把本应用移出电池优化名单（Settings 弹窗，用户可拒；拒了只是更容易被杀） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- P5 MediaProjection 截屏所需的前台服务类型（提前声明，避免届时要重编 APK 权限面） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13+ 通知授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- S0 配对探针的 mDNS 发现：NSD 底层组播在部分 ROM 不自动续持，必须显式申请
         MulticastLock（见 ui/MdnsWatcher）。装机即得，无需用户操作。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      悬浮窗（bridge:ui_automation 的辅助能力，也是无障碍不可用时的降级路径）。
      同样属 AppOps 特殊权限：声明后还需系统页授权。
      本档能否经 shell 静默授予不在这里规定 —— 以判据表 capability/CapabilityCatalog 的
      APPOP 分支为准（docs/contracts/ui-onboarding-spec.md §2.0「档位归口」）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      外部存储全量访问（bridge:storage 的代表能力）。
      ⚠ 这是 AppOps 特殊权限（非运行时权限）：Manifest 声明本身不给权，判据是
        Environment.isExternalStorageManager()。本档能否经 shell 静默授予同样以
        capability/CapabilityCatalog 的 APPOP 分支为准，不在此复述。
      tools:ignore 抑制 Lint 对「全文件访问」的强提示（本应用定位即为受管设备上的容器）。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 开机/重启后自启容器（拉起 OsHostService） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- HostBridge：安装应用（用户手动确认，PackageInstaller 会话） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- HostBridge：列举全部已装应用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- HostBridge：app.stop（ActivityManager.killBackgroundProcesses 是受保护调用，缺它必抛 SecurityException） -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 16KB 页对齐要求（Node 24 / 原生模块） -->
    <uses-feature android:name="android.hardware.ram.normal" android:required="false" />

    <application
        android:name=".OsApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LobOs"
        tools:targetApi="34"
        tools:ignore="UnusedAttribute"
        android:extractNativeLibs="true">
        <!--
          android:extractNativeLibs="true" 是必须的，且与 packaging.jniLibs.
          useLegacyPackaging = true 是同一件事的两种写法（两处都写，双保险）。

          原因：我们要 exec 的 node 二进制，以 jniLibs/arm64-v8a/libnode.so 的形式
          打包。只有 extractNativeLibs=true，Android 才会在【安装时】把这个 .so
          从 APK 里解压到
              /data/app/~~xxxx/<pkg>-yyyy/lib/arm64-v8a/libnode.so
          而那个目录是 SELinux 唯一允许 exec 的应用目录（label exec_type）。

          若为 false（AGP 3.6+ 的默认），.so 会以压缩形式留在 APK 内、运行时直接
          mmap 加载，不会在文件系统上落盘 —— 我们就拿不到可执行的路径，
          ProcessBuilder 会以 error=2 (No such file) 或 error=13 失败。

          顺带说明：这个属性只影响「.so 是否解压落盘」，不改变任何权限语义，
          也不影响 minSdk/兼容性。
        -->

        <!-- L-A 容器监督者（主进程，**常驻前台**）：唯一职责是监督 运行时实例 实例宿主的死活
             （ADR-0006）。它住 :main、被无障碍绑定托底，从而"重拉者"不再与被重拉者同进程
             —— 旧设计的根病。前台化是 2026-09-26 真机定罪的结论：不占通知位 = 锁屏被 ROM
             合法清掉，整条重拉链随 :main 一起归零。 -->
        <service
            android:name=".lifecycle.OsHostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="resident supervisor keeping the local runtime alive across screen-off" />
        </service>

        <!-- 运行时实例宿主（与 UI 同进程）：Node 是本进程的子进程，不再是独立 Android 进程。
             不占前台服务——唯一 FGS = OsHostService（单一生命周期）。 -->

        <!-- 能力桥（UDS）：随 APK 冻结；exported=false，仅本进程内的 Program 连接。
             由 OsHostService 拉起；不单独占前台服务（单一生命周期）。 -->


        <!-- 开机自启 + 覆盖安装后自动复活（升级 APK 后系统杀进程但不重启服务，
             MY_PACKAGE_REPLACED 是唯一能在“更新完”这一刻拿到的回调） -->
        <!-- 快速设置磁贴（A14 可见性载体）：状态出口 + 拉起宿主；不新增 FGS/通知 -->
        <service
            android:name=".lifecycle.StatusTileService"
            android:exported="true"
            android:icon="@drawable/ic_lobos_logo"
            android:label="Lob OS"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".lifecycle.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- PackageInstaller 会话结果回传（exported=false：PendingIntent 定向投递） -->
        <receiver
            android:name=".lifecycle.PackageInstallReceiver"
            android:exported="false" />

        <!-- 设备管理器（DO）已退出本产品（不做机制也不做能力）：不声明 device-admin 接收器。 -->

        <!-- 通知监听（bridge:notification → notif.read 能力的真实载体）。
             Secure 设置类授权：用户可在「设置 → 通知 → 通知使用权」手点，S0 通道在位时
             也可经 shell `settings put secure enabled_notification_listeners …` 静默开启
             （Android 17 仍保留 WRITE_SECURE_SETTINGS；真机 2026-09-25 定罪）。
             DO 反而**不能**静默授予这一档 —— 取法链见 capability/CapabilityCatalog。 -->
        <service
            android:name=".bridge.OsNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 无障碍服务（bridge:ui_automation 能力） -->
        <service
            android:name=".lifecycle.OsAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- S0 配对探针（:main，ADR-0007）：RemoteInput 输码必须落 Service —— 落 Activity
             会夺焦销毁系统配对对话框，整个主路径就失效。通知是常态通知，非 FGS。 -->
        <service
            android:name=".ui.PairingProbeService"
            android:exported="false" />

        <!-- 入口 = 开场管线首页（G1）。诊断页/工作台降级为页内可达（S3/S4 按钮跳转），
             MainActivity 仍 exported：am start / 旧快捷方式直达不被切断。 -->
        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.console.ConsoleActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name" />

        <!-- Doze 兜底唤醒（AUD-G22）：周期投递"确保宿主在"，不是复活机制（ADR-0006 D4）。 -->
        <receiver
            android:name=".lifecycle.DozeBackstopReceiver"
            android:exported="false" />

        <!-- 截屏会话的临时 FGS（A5）：持有 MediaProjection 期间必须存在，类型 mediaProjection。
             稳态不常驻 —— 会话结束即 stopSelf。 -->
        <service
            android:name=".bridge.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
