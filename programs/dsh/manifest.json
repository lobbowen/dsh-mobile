{
  "id": "dsh",
  "name": "DeepSeek Harness",
  "role": "agent",
  "version": "0.1.7-rc.2",
  "runtime": {
    "name": "node",
    "range": ">=24 <25"
  },
  "entry": "lib/bin.js",
  "args": [
    "web",
    "--no-open"
  ],
  "ports": {
    "http": {
      "env": "PORT",
      "health": "/"
    }
  },
  "capabilities": [
    "fs.workspace",
    "net.loopback",
    "ui.automation?",
    "notify.post?"
  ],
  "storage": {
    "workspace": true,
    "quotaMB": 512
  },
  "resource": {
    "class": "on-demand",
    "maxRssMB": 512
  },
  "ui": {
    "kind": "http",
    "path": "/__host"
  },
  "_note": "第一个默认 agent 载荷。载荷品牌只允许出现在本目录与其适配器内。"
}
